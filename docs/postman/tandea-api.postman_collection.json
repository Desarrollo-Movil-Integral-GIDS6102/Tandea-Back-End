    {
      "name": "3. Pagos (Payments & Dual Confirmation)",
      "item": [
        {
          "name": "3.1 Registrar Pago en Efectivo (multipart, sin archivo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.idPayment) {",
                  "    pm.collectionVariables.set('pagoId', res.idPayment);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_participante}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "idNumber", "value": "{{idNumber}}", "type": "text" },
                { "key": "metodoPago", "value": "efectivo", "type": "text" },
                { "key": "cashAmount", "value": "1500.00", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/pagos",
              "host": ["{{baseUrl}}"],
              "path": ["pagos"]
            }
          }
        },
        {
          "name": "3.2 Registrar Pago Híbrido (multipart con comprobante en file)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.idPayment) {",
                  "    pm.collectionVariables.set('pagoId', res.idPayment);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_participante}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "idNumber", "value": "{{idNumber}}", "type": "text" },
                { "key": "metodoPago", "value": "hibrido", "type": "text" },
                { "key": "cashAmount", "value": "500.00", "type": "text" },
                { "key": "transferAmount", "value": "1000.00", "type": "text" },
                { "key": "file", "type": "file", "src": "comprobante.jpg" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/pagos",
              "host": ["{{baseUrl}}"],
              "path": ["pagos"]
            }
          }
        },
        {
          "name": "3.3 Obtener Pago por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_organizador}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pagos/{{pagoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["pagos", "{{pagoId}}"]
            }
          }
        },
        {
          "name": "3.4 Confirmar Pago por Organizador",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_organizador}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pagos/{{pagoId}}/confirmar-organizador",
              "host": ["{{baseUrl}}"],
              "path": ["pagos", "{{pagoId}}", "confirmar-organizador"]
            }
          }
        },
        {
          "name": "3.5 Confirmar Pago por Receptor",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_participante}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pagos/{{pagoId}}/confirmar-receptor",
              "host": ["{{baseUrl}}"],
              "path": ["pagos", "{{pagoId}}", "confirmar-receptor"]
            }
          }
        }
      ]
