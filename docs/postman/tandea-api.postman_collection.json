            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tanda Vacaciones con Respaldo\",\n  \"description\": \"Tanda protegida con turno de número muerto para cubrir morosos\",\n  \"startDate\": \"2026-12-01\",\n  \"contributionAmount\": 2000.00,\n  \"numParticipants\": 6,\n  \"numRounds\": 1,\n  \"graceDays\": 3,\n  \"hasDeadNumber\": true,\n  \"idTandaType\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tandas",
              "host": ["{{baseUrl}}"],
              "path": ["tandas"]
            }
          }
        },
