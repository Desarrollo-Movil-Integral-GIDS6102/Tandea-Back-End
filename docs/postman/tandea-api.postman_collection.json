    {
      "name": "2. Tandas (CRUD, Filtros, Paginación)",
      "item": [
        {
          "name": "2.1 Crear Tanda Regular (Organizador)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.idTanda) {",
                  "    pm.collectionVariables.set('tandaId', res.data.idTanda);",
                  "    pm.collectionVariables.set('inviteCode', res.data.inviteCode);",
                  "    console.log('Tanda creada:', res.data.idTanda, 'Código:', res.data.inviteCode);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_organizador}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tanda Navideña 2026\",\n  \"description\": \"Ahorro para regalos y cena de fin de año\",\n  \"startDate\": \"2026-11-01\",\n  \"contributionAmount\": 1500.00,\n  \"numParticipants\": 5,\n  \"numRounds\": 1,\n  \"graceDays\": 2,\n  \"hasDeadNumber\": false,\n  \"idTandaType\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tandas",
              "host": ["{{baseUrl}}"],
              "path": ["tandas"]
            }
          }
        },
        {
          "name": "2.2 Crear Tanda con Número Muerto (Respaldo)",
          "request": {
            "method": "POST",
            "header": [
