            "url": {
              "raw": "{{baseUrl}}/tandas/{{tandaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tandas", "{{tandaId}}"]
            }
          }
        },
        {
          "name": "2.11 Actualizar Nombre y Descripción de la Tanda",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_organizador}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
