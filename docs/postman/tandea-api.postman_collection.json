            },
            "url": {
              "raw": "{{baseUrl}}/tandas/{{tandaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tandas", "{{tandaId}}"]
            }
          }
        },
        {
          "name": "2.12 Cambiar Estado de la Tanda (a ACTIVA)",
          "request": {
            "method": "PATCH",
            "header": [
