# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/tandea_dev
DATABASE_SSL=false

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*

# ── Autenticación JWT ────────────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_aqui

# ── Correo y Notificaciones (Brevo) ──────────────────────────────────────────
BREVO_API_KEY=tu_api_key_de_brevo
BREVO_SENDER_EMAIL=notificaciones@tandea.app
BREVO_SENDER_NAME=Tandea

# ── Google Cloud Vision OCR ──────────────────────────────────────────────────
# Configura el JSON completo de la cuenta de servicio en .env o en el gestor de
# secretos del despliegue. No pegues ni subas credenciales reales a Git.
GOOGLE_VISION_CREDENTIALS=

# ── Recordatorios de pago (AP-08) ────────────────────────────────────────────
# Días antes de la fecha límite (fechaCobro + días de gracia) en que el cron de
# las 9:00 (CDMX) avisa a quien no ha pagado. 0 = el mismo día. Por defecto 1.
RECORDATORIO_DIAS_ANTES=1

# ── Notificaciones Push (Firebase Cloud Messaging) ───────────────────────────
# Cuenta de servicio en JSON o Base64 (NUNCA subir el archivo JSON al repositorio)
FIREBASE_SERVICE_ACCOUNT=


